# 本地开发环境变量
# 复制为 .dev.vars 后填写真实值（.dev.vars 已被 .gitignore 忽略）
# 生产环境用 wrangler secret put <NAME> 设置，不写入文件

# 渠道配置 AES-GCM 加密密钥（32 字节随机串）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT 签名密钥（必填：缺失时登录签发与鉴权直接 500，不再回退默认密钥）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 管理员密码
ADMIN_PASSWORD=

# 邮件发信（Teaven Email 服务）：商户找回密码依赖
# 在 Teaven Email 后台创建 API Key（需 SEND_MAIL 权限）后填入
TEAVEN_EMAIL_API_KEY=
# 可选：Teaven Email 服务地址，默认 https://email.teaven.email/v1/mail/send
# 也可只填服务根地址（如 https://email.teaven.email），会自动补 /v1/mail/send
TEAVEN_EMAIL_ENDPOINT=
