# 本地开发环境变量
# 复制为 .dev.vars 后填写真实值（.dev.vars 已被 .gitignore 忽略）
# 生产环境用 wrangler secret put <NAME> 设置，不写入文件

# 渠道配置 AES-GCM 加密密钥（32 字节随机串）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT 签名密钥（必填：缺失时登录签发与鉴权直接 500，不再回退默认密钥）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 管理员密码
ADMIN_PASSWORD=
